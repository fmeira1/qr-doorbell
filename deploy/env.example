# Puerto HTTP del servidor (default: 8081)
PORT=8081

# URL pública (usada en links de Telegram y notificaciones)
BASE_URL=https://timbre.tudominio.com

# Postgres (obligatorio en producción)
DATABASE_URL=postgres://qrdoorbell_user:tu_password_seguro@localhost:5432/qrdoorbell?sslmode=disable

# JWT para autenticación de usuarios (obligatorio para login/admin)
JWT_SECRET=cambiame-por-una-clave-larga-y-segura

# Admin inicial (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=CambiarAlPrimerLogin123

# Telegram (opcional, si están vacíos no se envían notificaciones)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Geovalla (opcional, si GEOFENCE_RADIUS_METERS > 0 se exige ubicación)
DOORBELL_LAT=
DOORBELL_LON=
GEOFENCE_RADIUS_METERS=
